{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pumpkin-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",

  // 빌드 결과(dist)를 정적 에셋으로. SPA라서 못 찾는 경로는 index.html 로.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* 만 Worker 가 먼저 받는다. 나머지는 에셋이 바로 응답.
    "run_worker_first": ["/api/*"]
  },

  // Cloud Run 주소. 비밀이 아니라서 여기 둔다.
  // (대시보드에서만 바꾸면 다음 배포 때 이 값으로 되돌아온다. 바꿀 땐 여기를 고쳐 푸시.)
  "vars": {
    "API_ORIGIN": "https://pumpkin-api-352099585813.asia-northeast3.run.app"
  },

  "routes": [{ "pattern": "pumpkin.zzam.today", "custom_domain": true }],

  "observability": { "enabled": true }
}
